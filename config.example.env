# pi-superagent configuration — copy to $PI_SUPERAGENT_STATE/config.env (default
# ~/.pi/superagent/config.env). Plain KEY=value lines, read by scripts/superagent at
# start. Only the first two are needed to run for real.

# ---- front door (GitHub issues are the only one; leave the repo unset to run intake off) ----
PI_SUPERAGENT_GITHUB_REPO=your-org/your-repo
# The login the agent posts replies from; used to recognize (and ignore) its own writing.
PI_SUPERAGENT_GITHUB_SELF=your-agent[bot]
# Comma-separated author patterns that are bots, never people (default: pi-*,fleet-*).
#PI_SUPERAGENT_BOTS=pi-*,fleet-*,github-actions[bot]

# ---- supervisor identity ----
#PI_SUPERAGENT_STATE=$HOME/.pi/superagent        # state dir: store, cursors, worker records, logs
#PI_SUPERAGENT_SESSION=superagent                # herdr agent (supervisor) name
#PI_SUPERAGENT_HERDR_WORKSPACE=superagent        # herdr workspace label for worker tabs
#PI_SUPERAGENT_HERDR=herdr                       # path to the herdr binary

# ---- limits and cadence ----
#PI_SUPERAGENT_MAX_WORKERS=4                     # concurrent worker sessions
#PI_SUPERAGENT_TICK_MS=60000                     # source poll interval
#PI_SUPERAGENT_GRACE=30                          # seconds a stop waits before killing a worker
#PI_SUPERAGENT_PANEL_PORT=8788                   # web panel port

# ---- judge ----
#PI_SUPERAGENT_JUDGE_THINKING=medium             # thinking level for the assessor's model call

# ---- worker sandbox ----
#PI_SUPERAGENT_WORKTREES=$PI_SUPERAGENT_STATE/work   # where worker checkouts live
#PI_SUPERAGENT_BLOCKED=git push,rm -rf           # commands a worker's tool calls may not run
#PI_SUPERAGENT_ALLOW_DELEGATION=1                # let workers spawn their own subagents (off by default)
#PI_SUPERAGENT_PREPARE=scripts/prepare.sh        # per-worker setup script (deps, env)
