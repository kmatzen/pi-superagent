<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The health check. Every five minutes it asks `superagent status` and starts the router when the
     answer is "down"; the respect-stop flag leaves a router that was stopped on purpose alone.
     Install it by replacing every __HOME__ with your home directory (launchd does not expand ~):
       sed "s|__HOME__|$HOME|g" com.example.superagent-health.plist \
         > ~/Library/LaunchAgents/com.example.superagent-health.plist
       launchctl load ~/Library/LaunchAgents/com.example.superagent-health.plist
     From a checkout, replace superagent below with the full path of scripts/superagent. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.superagent-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>superagent --respect-stop status &gt;/dev/null 2&gt;&amp;1 || superagent --respect-stop start</string>
  </array>
  <!-- launchd starts a job with a bare PATH, and the job needs superagent, herdr, node and pi: Homebrew's
       directories and npm's usual global bin directories. Add yours if it is elsewhere (nvm's is). -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:__HOME__/.npm-global/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/superagent-health.log</string>
  <key>StandardErrorPath</key><string>/tmp/superagent-health.log</string>
</dict>
</plist>
