#!/usr/bin/env bash
# check-formal — model-check every formal/*.cfg spec with TLC; exit 0 only when all proofs complete.
#
# Silent success is the defect class: a missing java, a missing jar, a parse error, an
# invariant violation, or a truncated run all exit non-zero with a one-line reason.
set -euo pipefail
cd "$(dirname "$0")/.."

# A version, not "latest": the jar is executed, so an unverified upstream release must not run here — and not
# in the nightly CI job either (audit 2026-11-11). Bump TLA2TOOLS_VERSION deliberately; the cache path carries
# the version, so a bump fetches fresh and leaves the old jar alone.
TLA2TOOLS_VERSION="${TLA2TOOLS_VERSION:-v1.7.4}"
JAR="${TLA2TOOLS_JAR:-$HOME/.cache/tla2tools/tla2tools-$TLA2TOOLS_VERSION.jar}"
JAVA="${JAVA:-}"
if [ -z "$JAVA" ]; then
  for c in /opt/homebrew/opt/openjdk/bin/java /usr/local/opt/openjdk/bin/java; do
    [ -x "$c" ] && JAVA="$c" && break
  done
  [ -n "$JAVA" ] || JAVA="$(command -v java || true)"
fi
[ -n "$JAVA" ] && "$JAVA" -version >/dev/null 2>&1 \
  || { echo "check-formal: no working java (set JAVA=)"; exit 1; }

if [ ! -f "$JAR" ]; then
  mkdir -p "$(dirname "$JAR")"
  echo "fetching tla2tools.jar $TLA2TOOLS_VERSION ..."
  curl -sSL -o "$JAR" "https://github.com/tlaplus/tlaplus/releases/download/$TLA2TOOLS_VERSION/tla2tools.jar" \
    || { rm -f "$JAR"; echo "check-formal: could not fetch $JAR"; exit 1; }
fi

rc=0
for cfg in formal/*.cfg; do
  spec="${cfg%.cfg}"
  out="$(mktemp)"
  if ! "$JAVA" -XX:+UseParallelGC -Xmx4g -cp "$JAR" tlc2.TLC -config "$cfg" "$spec.tla" >"$out" 2>&1; then
    grep -E "Error|violat" "$out" | head -5
    echo "check-formal: ${spec##*/} FAILED"
    rc=1
  elif grep -qE "violated|not a state predicate|Parse Error" "$out"; then
    grep -E "violated|not a state predicate|Parse Error" "$out" | head -3
    echo "check-formal: ${spec##*/} FAILED"
    rc=1
  else
    printf '%-10s %s\n' "${spec##*/}:" "$(grep -E 'distinct states found' "$out" | tail -1)"
  fi
  rm -f "$out"
done
[ "$rc" = 0 ] && echo "check-formal: proof complete — every reachable state checked"
exit "$rc"
