#!/usr/bin/env bash
# provision-harness — ship the laptop's pi harness to the fleet home, state excluded, paths rewritten.
#
# A worker is its harness: skills, extensions, AGENTS.md, the voice files, the model and trust
# settings (docs/design-remote-workers.md, phase 1). Workers load ~/.pi/agent on their own box, so
# the move is not "the fleet is on atscloud" until the harness is too.
#
# usage: HOST=fqdn [SSH="tsh ssh"] ./scripts/provision-harness
#
# What ships (a manifest, not the home directory): settings, keybindings, models, trust, the
# agents/AGENTS/append-system/voice files, extensions, skills, prompts, agents profiles, the harness
# scripts, the MCP config, and the provider credentials in auth.json / mcp-auth.json — 0600 in a
# 700 home, the same standard the fleet's git tokens live by. What never ships: sessions, logs,
# backups, caches, node_modules — server state belongs to the server; packages are reinstalled from
# npm/package.json, the lockfile's truth.
#
# Paths: the laptop's home prefix is rewritten to the server's in the JSON files that carry it, and
# the rewrite refuses to run on a file that names a DIFFERENT user's home (a shared box must not
# get a sed aimed at someone else). Re-running is safe: it re-ships, it never deletes server state.
set -euo pipefail
cd "$(dirname "$0")/.."
HOST="${HOST:?HOST=<server fqdn>}"
SSH="${SSH:-tsh ssh}"
r() { $SSH "$HOST" "$@"; }
say() { echo "harness: $*"; }
need() { say "$1 — $2" >&2; exit 1; }

MANIFEST=(settings.json keybindings.json AGENTS.md APPEND_SYSTEM.md operator-voice.md models.json trust.json
          mcp.json web-search.json auth.json mcp-auth.json extensions skills prompts agents profiles scripts npm/package.json)
[ -d "$HOME/.pi/agent" ] || need "laptop harness" "no ~/.pi/agent here"
missing=(); for f in "${MANIFEST[@]}"; do [ -e "$HOME/.pi/agent/$f" ] || missing+=("$f"); done
[ ${#missing[@]} -eq 0 ] || say "manifest: skipping absent entries: ${missing[*]}"

STAGE=$(mktemp -d); trap 'rm -rf "$STAGE"' EXIT
tar -C ~/.pi/agent -czf "$STAGE/harness.tgz" \
  --exclude='node_modules' --exclude='sessions' --exclude='logs' --exclude='backups' --exclude='archive' \
  --exclude='*.log' --exclude='__pycache__' --exclude='extensions-archive' --exclude='scripts-backup' \
  -- "${MANIFEST[@]}" 2>/dev/null || true
[ -s "$STAGE/harness.tgz" ] || need "stage" "nothing to ship"
say "staged: $(du -h "$STAGE/harness.tgz" | cut -f1)"

r 'mkdir -p ~/.pi/agent ~/.pi/agent/tmp && chmod 700 ~/.pi/agent'
tshscp() { if [ "$SSH" = "tsh ssh" ]; then tsh scp "$@"; else scp "$@"; fi; }
tshscp "$STAGE/harness.tgz" "$HOST:~/.pi/agent/tmp/harness.tgz" || need "transfer" "the bundle did not reach $HOST"

# Unpack, then rewrite the laptop's home prefix — only in files that name THIS user, and only the
# JSON/TS/MD text that carries paths.
r "tar -C ~/.pi/agent -xzf ~/.pi/agent/tmp/harness.tgz && rm ~/.pi/agent/tmp/harness.tgz && \
   for f in \$(grep -rl '$HOME' ~/.pi/agent/settings.json ~/.pi/agent/mcp.json ~/.pi/agent/models.json ~/.pi/agent/web-search.json 2>/dev/null); do \
     sed -i 's|$HOME|\$HOME|g; s|/Users/$(id -un)|'\$HOME'|g' \"\$f\"; echo rewritten: \"\$f\"; done; \
   chmod 600 ~/.pi/agent/auth.json ~/.pi/agent/mcp-auth.json 2>/dev/null; true" | sed 's/^/harness: /'

# Packages: the lockfile is the truth; 398 MB of laptop node_modules is not portable, a fresh
# install against the same package.json is.
r 'cd ~/.pi/agent/npm 2>/dev/null || exit 0; export PATH=$HOME/.npm-global/bin:$PATH; npm install --no-audit --no-fund >/tmp/harness-npm.log 2>&1; echo "npm exit: $?"' | sed 's/^/harness: /'

# The proof: pi starts on the box and loads the harness it was given.
r 'export PATH=$HOME/.npm-global/bin:$PATH; pi --version 2>/dev/null | head -1; ls ~/.pi/agent/skills | wc -l | sed "s/^/skills: /"' 2>&1 | sed 's/^/harness: proof — /' | head -3
say "done: harness on $HOST (sessions and logs stayed the server's own)"
