#!/usr/bin/env bash
# provision-remote — make one atscloud server a fleet home, idempotently.
#
# The fleet moves whole (docs/design-remote-workers.md): router, judge, state, workers on the
# server; the laptop is a window. This script prepares the box: node, pi, pi-superagent, the bot's
# gh and git identity, the state directory, the config, and the cron supervision that replaces
# launchd. Re-running it changes nothing already true; it never deletes remote state.
#
# usage:
#   TARBALL=/path/pi-superagent-0.1.4.tgz HOST=fqdn [SSH="tsh ssh"] [SECRETS=0] ./scripts/provision-remote
#
# Files it reads from the laptop, and ships 0600 (SECRETS=1 only — the first provision and token
# rotations; day-to-day runs keep secrets out of the transport):
#   ~/.pi/superagent/github-token   the bot's gh token   (worker and PR voice)
#   ~/.pi/superagent/worker-token-file   the worker token, if the config names one
#
# What it will NOT do: log in to Teleport (agents cannot), stop a running router, touch anything
# outside ~, or write any file world-readable. It says what it did, one line per step, and exits
# non-zero on the first step that is neither true nor fixable.
set -euo pipefail
cd "$(dirname "$0")/.."

HOST="${HOST:?HOST=<server fqdn> (the tsh node name, e.g. sj1010010240195.corp.adobe.com)}"
SSH="${SSH:-tsh ssh}"
TARBALL="${TARBALL:-}"
SECRETS="${SECRETS:-0}"
PI_PKG="@earendil-works/pi-coding-agent"
NODE_MIN=20
r() { $SSH "$HOST" "$@"; }
say() { echo "provision: $*"; }
need() { say "$1 — $2" >&2; exit 1; }

[ -n "$TARBALL" ] && [ -f "$TARBALL" ] || need "no packed tarball" "npm pack, then TARBALL=path: $TARBALL"

# 1. The box answers, and we are who we think we are.
WHO=$(r 'echo $(whoami)@$(hostname)' 2>/dev/null) || need "ssh" "$SSH $HOST did not answer (Teleport login is the operator's: tsh login --proxy=teleport.adobe.net)"
HOME_MODE=$(r 'stat -c %a ~')
[ "$HOME_MODE" -le 700 ] 2>/dev/null || need "home permissions" "~ is $HOME_MODE — tokens live here; chmod 700 first"
say "box: $WHO, home $HOME_MODE"

# 2. node >= NODE_MIN. The Ubuntu candidate is 18; a fleet on it is a fleet on a dead runtime,
#    so the missing case installs NodeSource, sudo required (the operator's standing grant).
NODE=$(r 'node -v 2>/dev/null | sed "s/^v//" | cut -d. -f1' || true)
if [ -z "$NODE" ] || [ "$NODE" -lt "$NODE_MIN" ]; then
  r 'sudo -n true' 2>/dev/null || need "node $NODE_MIN" "node is '$NODE' and sudo -n fails — install node $NODE_MIN by hand"
  r 'curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash - >/tmp/nodesource.log 2>&1 && sudo -n apt-get install -y nodejs >>/tmp/nodesource.log 2>&1' \
    || need "node 22 install" "see /tmp/nodesource.log on the server"
  say "node: installed $(r 'node -v')"
else
  say "node: node$(NODE) already there"
fi

# 3. User-global npm prefix: the fleet installs beside itself, sudo stays out of npm.
r 'test -d ~/.npm-global || mkdir -p ~/.npm-global; grep -qs ".npm-global/bin" ~/.bashrc || echo "export PATH=\$HOME/.npm-global/bin:\$PATH" >> ~/.bashrc; npm config set prefix ~/.npm-global >/dev/null'
# 4. pi, and pi-superagent from the proven tarball.
r "export PATH=\$HOME/.npm-global/bin:\$PATH; command -v pi >/dev/null || npm install -g --no-audit --no-fund $PI_PKG >/tmp/provision-pi.log 2>&1" \
  || need "pi install" "see /tmp/provision-pi.log on the server"
$SSH "$HOST" "mkdir -p /tmp/fleet-incoming" 
tshscp() { if [ "$SSH" = "tsh ssh" ]; then tsh scp "$@"; else scp "$@"; fi; }
tshscp "$TARBALL" "$HOST:/tmp/fleet-incoming/" || need "transfer" "the tarball did not reach $HOST"
TGZ=$(basename "$TARBALL")
r "export PATH=\$HOME/.npm-global/bin:\$PATH; npm install -g --no-audit --no-fund /tmp/fleet-incoming/$TGZ >/tmp/provision-sa.log 2>&1" \
  || need "pi-superagent install" "see /tmp/provision-sa.log on the server"
say "installed: $(r 'export PATH=$HOME/.npm-global/bin:$PATH; pi --version 2>/dev/null | head -1; superagent --help 2>&1 | head -1' | tr "\n" " ")"

# 5. State directory, 700: the database is the fleet's memory and the tokens are its keys.
r 'mkdir -p ~/.pi/superagent && chmod 700 ~/.pi/superagent'

# 6. Secrets, on request only: ship the bot's tokens 0600, nothing else, nothing logged.
if [ "$SECRETS" = "1" ]; then
  for f in github-token; do
    [ -f "$HOME/.pi/superagent/$f" ] || need "secret" "no ~/.pi/superagent/$f on the laptop"
    tshscp "$HOME/.pi/superagent/$f" "$HOST:~/.pi/superagent/$f" && r "chmod 600 ~/.pi/superagent/$f"
  done
  [ -f "$HOME/.pi/superagent/worker-token-file" ] && { tshscp "$HOME/.pi/superagent/worker-token-file" "$HOST:~/.pi/superagent/worker-token-file" && r "chmod 600 ~/.pi/superagent/worker-token-file"; }
  say "secrets: token files shipped 0600"
fi

# 7. The bot's voice: gh auth, git identity — from the token that is now on the box. The check
#    prints the login so a human sees who the fleet is on this server.
GHWHO=$(r 'GH_TOKEN=$(cat ~/.pi/superagent/github-token 2>/dev/null) gh api user --jq .login' 2>/dev/null || true)
[ -n "$GHWHO" ] && say "gh: api answers as $GHWHO" || say "gh: api did not answer — check github-token on the server"
r 'git config --global user.name >/dev/null 2>&1 || git config --global user.name "matzenbot_adobe"; git config --global user.email >/dev/null 2>&1 || git config --global user.email "matzenbot+adobe@adobe.com"'

# 8. Cron supervision — the launchd twin: remedy (start if down) daily, and at boot. Existing
#    superagent lines are replaced by id, foreign crontab lines are kept verbatim.
r '(crontab -l 2>/dev/null | grep -v "pi-superagent-health" ; \
   echo "# pi-superagent-health"; \
   echo "17 3 * * * PATH=\$HOME/.npm-global/bin:\$PATH \$HOME/.npm-global/bin/superagent remedy >/dev/null 2>&1 # pi-superagent-health"; \
   echo "@reboot sleep 30; PATH=\$HOME/.npm-global/bin:\$PATH \$HOME/.npm-global/bin/superagent remedy >/dev/null 2>&1 # pi-superagent-health") | crontab -'
say "cron: remedy daily 03:17 and @reboot installed (launchd twin)"

# 9. Config, written only when absent — the server's config is the server's from then on. The
#    watched repo is read from the laptop's config and embedded: an empty repo line means a router
#    that watches nothing, and says so only in the log.
REPO=$(sed -n 's/^PI_SUPERAGENT_GITHUB_REPO=//p' "$HOME/.pi/superagent/config.env" 2>/dev/null | head -1)
[ -n "$REPO" ] || need "config" "no PI_SUPERAGENT_GITHUB_REPO in the laptop's config.env — the server needs the watched repo"
r "test -f ~/.pi/superagent/config.env || { printf 'PI_SUPERAGENT_GITHUB_REPO=$REPO\nPI_SUPERAGENT_GITHUB_TOKEN_FILE=\$HOME/.pi/superagent/github-token\nPI_SUPERAGENT_MAX_WORKERS=3\nPI_SUPERAGENT_WORK_BUDGET_GB=50\n' > ~/.pi/superagent/config.env; chmod 600 ~/.pi/superagent/config.env; echo created; }" \
  | grep -q created && say "config: ~/.pi/superagent/config.env created (MAX_WORKERS=3 for a 4-core box — edit as measured)" || say "config: kept the server's existing config.env"

# 10. The proof, not the promise.
r 'export PATH=$HOME/.npm-global/bin:$PATH; superagent status' 2>&1 | head -2 | sed 's/^/provision: status — /' || true
say "next: ship state (superagent stop on the laptop, tsh scp the state dir, start here), then pilot one ticket"
